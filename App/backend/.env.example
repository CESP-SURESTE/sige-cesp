# ============================================================
# sige-cesp — Backend (.env)
# ============================================================
# Copia este archivo a `.env` (misma carpeta) y rellena los valores
# reales. `.env` está en `.gitignore` — NUNCA se sube al repo, ni
# siquiera a un repo privado.
#
# En el hosting (Railway/Render/lo que se elija para el backend), estas
# variables se configuran en el panel del proveedor ("Environment
# Variables"), NO subiendo un archivo `.env` — el archivo real solo
# vive en tu máquina y en el panel del proveedor, en ningún otro lado.
#
# Convención de este archivo: cada variable dice explícitamente si es
# SECRETA (nunca compartir el valor real: ni en este repo, ni en un
# chat, ni en un issue/PR, ni en ningún archivo versionado) o si es
# segura de ver/compartir (URLs públicas, flags, config sin
# credenciales).
# ============================================================

# --- Base de datos (Supabase Postgres) ---
# Detalle completo de por qué son 2 URLs distintas y qué puerto usa
# cada una: docs/setup-backend-prisma-supabase.md

# 🔒 SECRETA — incluye la contraseña de la base de datos.
# Transaction pooler (puerto 6543) + `?pgbouncer=true` al final — es la
# que usa la app en runtime, todas las queries de Prisma Client pasan
# por acá.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 🔒 SECRETA — mismo host que DATABASE_URL, puerto distinto (5432,
# session pooler), SIN `?pgbouncer=true`. Solo la usa el Prisma CLI
# para migraciones (`prisma migrate deploy`), nunca la app en runtime.
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase (Auth + Admin API) ---

# ✅ Segura de ver — es la URL del proyecto de Supabase, no un
# secreto en sí misma. Vive también en el frontend como
# NEXT_PUBLIC_SUPABASE_URL (mismo valor, dos copias porque cada app
# lee su propio .env).
SUPABASE_URL="https://[ref].supabase.co"

# ✅ Segura de exponer — clave "publishable" (prefijo sb_publishable_),
# diseñada para poder vivir en el cliente. Respeta RLS, no se lo salta.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxx"

# 🔒 SECRETA — CRÍTICA. Prefijo sb_secret_, se salta RLS por completo
# (BYPASSRLS). Si esta key se filtra (navegador, log público, repo
# expuesto) cualquiera puede leer/escribir TODA la base sin ninguna
# restricción. NUNCA con prefijo NEXT_PUBLIC_, NUNCA en el frontend,
# NUNCA en un log.
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxx"

# ✅ Segura de ver — endpoint estándar de Supabase Auth (no es un
# secreto, cualquier cliente OAuth/JWT público lo necesita conocer). El
# backend lo usa para verificar la firma de los JWT (`@supabase/server`).
SUPABASE_JWKS_URL="https://[ref].supabase.co/auth/v1/.well-known/jwks.json"

# --- Servidor ---

# ✅ No es secreta. En Railway/Render normalmente NO hace falta
# setearla — el proveedor inyecta su propio PORT con el puerto real que
# te asigna, y el código ya cae a ese valor si esta variable no existe.
# Convención de desarrollo local de este proyecto: 3001 (el frontend
# usa 3000, no deben chocar).
PORT=3001

# ✅ No es secreta (es una URL pública), pero SÍ importa que sea la
# correcta: es el único origen permitido por CORS (`main.ts`). Debe ser
# la URL REAL del frontend en producción (ej. tu dominio de Vercel o el
# subdominio final de CESP), sin slash final. Si se deja sin definir,
# cae a `http://localhost:3000` — en producción eso bloquea todas las
# requests reales del navegador con error de CORS.
FRONTEND_URL="https://tu-dominio-de-produccion.com"

# --- JWT propio de AdminPlataforma (Fase 6, Día 20) ---

# 🔒 SECRETA — CRÍTICA. Firma los JWT de 8h de la identidad
# `AdminPlataforma` (jose, HS256) — completamente separada del JWT de
# Supabase Auth. Si este secreto se filtra, cualquiera puede forjar un
# token de plataforma válido y actuar como si fuera un admin de NEXO SD.
# Genera un valor nuevo, largo y random para producción — NUNCA
# reutilices el que usas en desarrollo local. Ejemplo para generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_ADMIN_JWT_SECRET="genera-un-valor-random-largo-aqui"

# --- Mailgun (correos de bienvenida, Fase 4 Día 13) ---

# 🔒 SECRETA — da acceso a enviar correo en nombre de tu cuenta de
# Mailgun y a la configuración de esa cuenta.
MAILGUN_API_KEY="key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ✅ No es secreto — es el dominio configurado en Mailgun, visible de
# todas formas en los headers de cualquier correo que se envíe.
MAILGUN_DOMAIN="sandboxXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.mailgun.org"

# ✅ No es secreto — endpoint base de la API de Mailgun (varía si tu
# cuenta es US o EU).
MAILGUN_BASE_URL="https://api.mailgun.net/v3"

# ✅ No es secreto — flag propio de este proyecto (`true`/`false`).
# Falla CERRADO (apagado) por defecto a propósito, para no gastar la
# capa gratuita de Mailgun mientras se prueba. Actívalo explícitamente
# solo cuando el dominio real de CESP esté configurado en Mailgun con
# SPF/DKIM/DMARC propios (ver nota de Día 13 en CLAUDE.md) — si lo
# activas antes de eso, el correo real cae en spam porque sale del
# dominio sandbox de Mailgun sin reputación propia.
MAILGUN_ENVIOS_HABILITADO=false
