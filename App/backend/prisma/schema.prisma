generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================
// ENUMS
// ============================

enum RolUsuario {
  ALUMNO
  MAESTRO
  ADMINISTRATIVO
}

enum EstatusAcademico {
  INSCRITO
  BAJA_TEMPORAL
  BAJA_DEFINITIVA
  EGRESADO
}

enum TipoContacto {
  TUTOR
  EMERGENCIA
}

enum EstatusEmpleado {
  ACTIVO
  BAJA
  LICENCIA
}

enum TipoLicencia {
  VACACIONES
  INCAPACIDAD_ENFERMEDAD_GENERAL
  INCAPACIDAD_RIESGO_TRABAJO
  MATERNIDAD
  PATERNIDAD
  ADOPCION
  PERMISO_CON_GOCE_SUELDO
  PERMISO_SIN_GOCE_SUELDO
  OTRO
}

enum MotivoBaja {
  RENUNCIA
  DESPIDO
  BAJA_TEMPORAL_SALUD
  FALLECIMIENTO // art. 53 fr. II LFT — muerte del trabajador
  TERMINACION_INCAPACIDAD_PERMANENTE // art. 53 fr. IV LFT — incapacidad/inhabilidad permanente
  OTRO
}

enum PuestoAdministrativo {
  DIRECTOR
  COORDINADOR_ACADEMICO
  COORDINADOR_ADMINISTRATIVO
  AUXILIAR
  RECEPCION
  OTRO
}

enum NivelPermiso {
  SUPER_ADMIN
  ADMIN
  AUXILIAR
}

enum AccionAuditoria {
  ALTA
  BAJA
  EDICION
  CAMBIO_PERMISO
  CAMBIO_ESTATUS
  ELIMINACION
  CONSULTA_EMERGENCIA
  RESETEO_PASSWORD
}

enum NivelCarrera {
  TECNICO
  LICENCIATURA
  MAESTRIA
  DOCTORADO
}

enum ModalidadCarrera {
  PRESENCIAL
  SEMIPRESENCIAL
  EN_LINEA
}

enum EstatusCarrera {
  ACTIVA
  INACTIVA
}

enum AreaPersonalServicios {
  INTENDENCIA
  SEGURIDAD
  JARDINERIA
  MANTENIMIENTO
  OTRO
}

enum TipoNotificacion {
  AVISO
  RECORDATORIO_EVENTO
  EVENTO_NUEVO
}

enum CategoriaEvento {
  EXAMEN
  SOCIAL
  ADMINISTRATIVO
  SUSPENSION_CLASES
  OTRO
}

/// Compartido con Aviso (Fase 16) — mismo shape de "a quién le toca esto".
enum AlcanceDestino {
  SEDE
  CARRERA
  GRUPO
}

/// Tipo de sangre, capturado en InfoMedica* — 2026-09-07. Prisma no permite
/// `+`/`-` en nombres de enum; el label legible (`A+`, `O-`, etc.) vive solo
/// en el frontend.
enum TipoSangre {
  A_POSITIVO
  A_NEGATIVO
  B_POSITIVO
  B_NEGATIVO
  AB_POSITIVO
  AB_NEGATIVO
  O_POSITIVO
  O_NEGATIVO
}

/// Tipo de contratación del maestro, capturado en PerfilMaestro — 2026-09-07.
/// - BASE: plaza de base, sin fecha de término
/// - TEMPORAL: contrato por tiempo determinado, medido en días (`diasTemporal`)
/// - CONTRATO: contrato con fechas explícitas (`contratoFechaInicio`/`contratoFechaFin`)
enum TipoContratacion {
  BASE
  TEMPORAL
  CONTRATO
}

// ============================
// SEDE / INFRAESTRUCTURA
// ============================

model Sede {
  id                  String   @id @default(uuid())
  nombre              String   @unique
  direccion           String
  ubicacionReferencia String   @map("ubicacion_referencia")
  telefono            String
  costoRenta          Decimal? @map("costo_renta") @db.Decimal(10, 2)
  activa              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  carreras            Carrera[]
  salones             Salon[]
  usuarios            Usuario[]
  personalServicios   PersonalServicios[]
  grupos              Grupo[]
  responsables        SedeResponsable[]
  registrosAuditoria  RegistroAuditoria[]
  notificaciones      Notificacion[]
  eventosCalendario   EventoCalendario[]
  avisos              Aviso[]
  telefonosEmergencia TelefonoEmergenciaSede[]

  @@map("sedes")
}

model SedeResponsable {
  id               String               @id @default(uuid())
  sedeId           String               @map("sede_id")
  sede             Sede                 @relation(fields: [sedeId], references: [id])
  administrativoId String               @map("administrativo_id")
  administrativo   PerfilAdministrativo @relation(fields: [administrativoId], references: [id])
  esPrincipal      Boolean              @default(false) @map("es_principal")
  createdAt        DateTime             @default(now()) @map("created_at")

  @@unique([sedeId, administrativoId])
  @@map("sede_responsables")
}

model AdminPlataforma {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  nombre       String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  registrosAuditoria RegistroAuditoria[]

  @@map("admin_plataforma")
}

model Salon {
  id        String   @id @default(uuid())
  sedeId    String   @map("sede_id")
  sede      Sede     @relation(fields: [sedeId], references: [id])
  nombre    String
  capacidad Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  grupos Grupo[]

  @@unique([sedeId, nombre])
  @@map("salones")
}

model TelefonoEmergenciaSede {
  id        String   @id @default(uuid())
  sedeId    String   @map("sede_id")
  sede      Sede     @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  etiqueta  String
  telefono  String
  orden     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sedeId])
  @@map("telefonos_emergencia_sede")
}

// ============================
// CARRERA / MALLA
// ============================

model Carrera {
  id              String           @id @default(uuid())
  nombre          String
  clave           String           @unique
  sedeId          String           @map("sede_id")
  sede            Sede             @relation(fields: [sedeId], references: [id])
  duracion        Int
  nivel           NivelCarrera
  modalidad       ModalidadCarrera
  estatus         EstatusCarrera   @default(ACTIVA)
  rvoe            String?
  procedenciaRvoe String?          @map("procedencia_rvoe")
  descripcion     String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  mallaCurricular MallaCurricular?
  materias        Materia[]
  grupos          Grupo[]
  alumnos         PerfilAlumno[]

  @@map("carreras")
}

model MallaCurricular {
  id            String   @id @default(uuid())
  carreraId     String   @unique @map("carrera_id")
  carrera       Carrera  @relation(fields: [carreraId], references: [id])
  storagePath   String   @map("storage_path")
  nombreArchivo String   @map("nombre_archivo")
  subidaEn      DateTime @default(now()) @map("subida_en")
  subidaPorId   String   @map("subida_por")
  subidaPor     Usuario  @relation(fields: [subidaPorId], references: [id])

  @@map("mallas_curriculares")
}

// ============================
// GRUPO / MATERIA
// ============================

model Grupo {
  id          String   @id @default(uuid())
  sedeId      String   @map("sede_id")
  sede        Sede     @relation(fields: [sedeId], references: [id])
  carreraId   String   @map("carrera_id")
  carrera     Carrera  @relation(fields: [carreraId], references: [id])
  salonId     String   @map("salon_id")
  salon       Salon    @relation(fields: [salonId], references: [id])
  nombre      String
  anioInicio  Int      @map("anio_inicio")
  cicloActual Int      @map("ciclo_actual")
  capacidad   Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  alumnos      GrupoAlumno[]
  asignaciones GrupoMateriaMaestro[]

  @@map("grupos")
}

model GrupoAlumno {
  id               String       @id @default(uuid())
  grupoId          String       @map("grupo_id")
  grupo            Grupo        @relation(fields: [grupoId], references: [id])
  alumnoId         String       @map("alumno_id")
  alumno           PerfilAlumno @relation(fields: [alumnoId], references: [id])
  fechaInscripcion DateTime     @default(now()) @map("fecha_inscripcion")

  @@unique([grupoId, alumnoId])
  @@map("grupo_alumnos")
}

model Materia {
  id           String                @id @default(uuid())
  nombre       String
  carreraId    String                @map("carrera_id")
  carrera      Carrera               @relation(fields: [carreraId], references: [id])
  ciclo        Int
  createdAt    DateTime              @default(now()) @map("created_at")
  asignaciones GrupoMateriaMaestro[]

  @@map("materias")
}

model GrupoMateriaMaestro {
  id         String        @id @default(uuid())
  grupoId    String        @map("grupo_id")
  grupo      Grupo         @relation(fields: [grupoId], references: [id])
  materiaId  String        @map("materia_id")
  materia    Materia       @relation(fields: [materiaId], references: [id])
  maestroId  String        @map("maestro_id")
  maestro    PerfilMaestro @relation(fields: [maestroId], references: [id])
  asignadoEn DateTime      @default(now()) @map("asignado_en")

  @@unique([grupoId, materiaId, maestroId])
  @@map("grupo_materia_maestro")
}

// ============================
// USUARIO (cuenta de acceso)
// ============================

model Usuario {
  // OJO: mismo id que devuelve Supabase Auth al crear la cuenta — no se autogenera aquí
  id            String     @id
  email         String     @unique
  rol           RolUsuario
  sedeId        String     @map("sede_id")
  sede          Sede       @relation(fields: [sedeId], references: [id])
  codigoExterno String?    @unique @map("codigo_externo")
  primerIngreso Boolean    @default(true) @map("primer_ingreso")
  activo        Boolean    @default(true)
  ultimoAcceso  DateTime?  @map("ultimo_acceso")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  perfilAlumno         PerfilAlumno?
  perfilMaestro        PerfilMaestro?
  perfilAdministrativo PerfilAdministrativo?
  mallasSubidas        MallaCurricular[]
  registrosAuditoria   RegistroAuditoria[]
  notificaciones       Notificacion[]
  eventosCreados       EventoCalendario[]
  avisosCreados        Aviso[]

  @@map("usuarios")
}

// ============================
// MATRÍCULA (generación automática — ver PersonasService.altaPersona)
// ============================

/// Contador atómico, global (todas las sedes comparten la misma secuencia),
/// continuo durante el año (nunca se reinicia dentro del mismo año) y
/// reiniciado a 1 cada año nuevo. Una fila por año (`anio` = PK). El
/// incremento se hace con `upsert` + `{ increment: 1 }` dentro de la misma
/// transacción de `PersonasService.altaPersona` — Prisma compila esto a un
/// `INSERT ... ON CONFLICT DO UPDATE` nativo de Postgres (atómico desde
/// Prisma 4.6+ para Postgres), NO al patrón "leer la última matrícula y
/// sumarle 1" (con condición de carrera real bajo altas concurrentes).
model ContadorMatricula {
  anio         Int @id
  ultimoNumero Int @default(0) @map("ultimo_numero")

  @@map("contador_matricula")
}

// ============================
// ALUMNO
// ============================

model PerfilAlumno {
  id                 String           @id @default(uuid())
  usuarioId          String           @unique @map("usuario_id")
  usuario            Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombres            String
  apellidoPaterno    String           @map("apellido_paterno")
  apellidoMaterno    String?          @map("apellido_materno")
  curp               String?
  fechaNacimiento    DateTime         @map("fecha_nacimiento")
  matricula          String           @unique
  correoPersonal     String           @map("correo_personal")
  carreraId          String           @map("carrera_id")
  carrera            Carrera          @relation(fields: [carreraId], references: [id])
  estatusAcademico   EstatusAcademico @map("estatus_academico")
  periodoIngreso     String           @map("periodo_ingreso")
  cuatrimestreActual Int              @map("cuatrimestre_actual")
  telefono           String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  contactos  ContactoAlumno[]
  infoMedica InfoMedicaAlumno?
  grupos     GrupoAlumno[]

  @@map("perfiles_alumno")
}

model ContactoAlumno {
  id         String       @id @default(uuid())
  alumnoId   String       @map("alumno_id")
  alumno     PerfilAlumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  tipo       TipoContacto
  nombre     String
  telefono   String
  correo     String?
  parentesco String
  orden      Int

  @@map("contactos_alumno")
}

model InfoMedicaAlumno {
  id                   String       @id @default(uuid())
  alumnoId             String       @unique @map("alumno_id")
  alumno               PerfilAlumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  tieneCondicionMedica Boolean      @default(false) @map("tiene_condicion_medica")
  padecimiento         String?
  medicamentos         String?
  alergias             String?
  tratamientoAdicional String?      @map("tratamiento_adicional")
  tipoSangre           TipoSangre?  @map("tipo_sangre")

  @@map("info_medica_alumno")
}

// ============================
// MAESTRO
// ============================

model PerfilMaestro {
  id                  String            @id @default(uuid())
  usuarioId           String            @unique @map("usuario_id")
  usuario             Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombres             String
  apellidoPaterno     String            @map("apellido_paterno")
  apellidoMaterno     String?           @map("apellido_materno")
  curp                String
  cedulaProfesional   String?           @map("cedula_profesional")
  correoPersonal      String            @map("correo_personal")
  telefono            String
  fechaContratacion   DateTime          @map("fecha_contratacion")
  estatus             EstatusEmpleado
  tipoLicencia        TipoLicencia?     @map("tipo_licencia")
  motivoBaja          MotivoBaja?       @map("motivo_baja")
  tipoContratacion    TipoContratacion? @map("tipo_contratacion")
  diasTemporal        Int?              @map("dias_temporal")
  contratoFechaInicio DateTime?         @map("contrato_fecha_inicio")
  contratoFechaFin    DateTime?         @map("contrato_fecha_fin")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  contactos    ContactoMaestro[]
  infoMedica   InfoMedicaMaestro?
  asignaciones GrupoMateriaMaestro[]

  @@map("perfiles_maestro")
}

model ContactoMaestro {
  id         String        @id @default(uuid())
  maestroId  String        @map("maestro_id")
  maestro    PerfilMaestro @relation(fields: [maestroId], references: [id], onDelete: Cascade)
  nombre     String
  telefono   String
  correo     String?
  parentesco String
  orden      Int

  @@map("contactos_maestro")
}

model InfoMedicaMaestro {
  id                   String        @id @default(uuid())
  maestroId            String        @unique @map("maestro_id")
  maestro              PerfilMaestro @relation(fields: [maestroId], references: [id], onDelete: Cascade)
  tieneCondicionMedica Boolean       @default(false) @map("tiene_condicion_medica")
  padecimiento         String?
  medicamentos         String?
  alergias             String?
  tratamientoAdicional String?       @map("tratamiento_adicional")
  tipoSangre           TipoSangre?   @map("tipo_sangre")

  @@map("info_medica_maestro")
}

// ============================
// ADMINISTRATIVO
// ============================

model PerfilAdministrativo {
  id                String               @id @default(uuid())
  usuarioId         String               @unique @map("usuario_id")
  usuario           Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nombres           String
  apellidoPaterno   String               @map("apellido_paterno")
  apellidoMaterno   String?              @map("apellido_materno")
  curp              String
  correoPersonal    String               @map("correo_personal")
  telefono          String
  fechaContratacion DateTime             @map("fecha_contratacion")
  estatus           EstatusEmpleado
  tipoLicencia      TipoLicencia?        @map("tipo_licencia")
  motivoBaja        MotivoBaja?          @map("motivo_baja")
  puesto            PuestoAdministrativo
  nivelPermiso      NivelPermiso         @map("nivel_permiso")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  contactos   ContactoAdministrativo[]
  infoMedica  InfoMedicaAdministrativo?
  sedesACargo SedeResponsable[]
  permisos    PermisoAdministrativo[]

  @@map("perfiles_administrativo")
}

model ContactoAdministrativo {
  id               String               @id @default(uuid())
  administrativoId String               @map("administrativo_id")
  administrativo   PerfilAdministrativo @relation(fields: [administrativoId], references: [id], onDelete: Cascade)
  nombre           String
  telefono         String
  correo           String?
  parentesco       String
  orden            Int

  @@map("contactos_administrativo")
}

model InfoMedicaAdministrativo {
  id                   String               @id @default(uuid())
  administrativoId     String               @unique @map("administrativo_id")
  administrativo       PerfilAdministrativo @relation(fields: [administrativoId], references: [id], onDelete: Cascade)
  tieneCondicionMedica Boolean              @default(false) @map("tiene_condicion_medica")
  padecimiento         String?
  medicamentos         String?
  alergias             String?
  tratamientoAdicional String?              @map("tratamiento_adicional")
  tipoSangre           TipoSangre?          @map("tipo_sangre")

  @@map("info_medica_administrativo")
}

// ============================
// PERSONAL DE SERVICIOS (sin login)
// ============================

model PersonalServicios {
  id                String                @id @default(uuid())
  sedeId            String                @map("sede_id")
  sede              Sede                  @relation(fields: [sedeId], references: [id])
  nombres           String
  apellidoPaterno   String                @map("apellido_paterno")
  apellidoMaterno   String?               @map("apellido_materno")
  curp              String
  area              AreaPersonalServicios
  telefono          String
  correoPersonal    String?               @map("correo_personal")
  fechaContratacion DateTime              @map("fecha_contratacion")
  estatus           EstatusEmpleado
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  contactos  ContactoPersonalServicios[]
  infoMedica InfoMedicaPersonalServicios?

  @@map("personal_servicios")
}

model ContactoPersonalServicios {
  id                  String            @id @default(uuid())
  personalServiciosId String            @map("personal_servicios_id")
  personalServicios   PersonalServicios @relation(fields: [personalServiciosId], references: [id], onDelete: Cascade)
  nombre              String
  telefono            String
  correo              String?
  parentesco          String
  orden               Int

  @@map("contactos_personal_servicios")
}

model InfoMedicaPersonalServicios {
  id                   String            @id @default(uuid())
  personalServiciosId  String            @unique @map("personal_servicios_id")
  personalServicios    PersonalServicios @relation(fields: [personalServiciosId], references: [id], onDelete: Cascade)
  tieneCondicionMedica Boolean           @default(false) @map("tiene_condicion_medica")
  padecimiento         String?
  medicamentos         String?
  alergias             String?
  tratamientoAdicional String?           @map("tratamiento_adicional")
  tipoSangre           TipoSangre?       @map("tipo_sangre")

  @@map("info_medica_personal_servicios")
}

// ============================
// AUDITORÍA Y PERMISOS
// ============================

model RegistroAuditoria {
  id                String           @id @default(uuid())
  usuarioId         String?          @map("usuario_id")
  usuario           Usuario?         @relation(fields: [usuarioId], references: [id])
  adminPlataformaId String?          @map("admin_plataforma_id")
  adminPlataforma   AdminPlataforma? @relation(fields: [adminPlataformaId], references: [id])
  sedeId            String?          @map("sede_id")
  sede              Sede?            @relation(fields: [sedeId], references: [id], onDelete: SetNull)
  accion            AccionAuditoria
  entidad           String
  entidadId         String           @map("entidad_id")
  detalle           Json?
  fecha             DateTime         @default(now())

  @@map("registro_auditoria")
}

/// Notificación in-app para un usuario — Fase 14, Día 38. Capa compartida:
/// la crean el fan-out de avisos (Fase 16) y el job de recordatorios de
/// calendario (Fase 15). NO se audita (regla 5 aplica a acciones de
/// negocio; esto es estado de entrega derivado, alto volumen). `leidoEn`
/// null = no leída; el badge cuenta esas. `referenciaId` apunta a
/// `Aviso.id` o `EventoCalendario.id` según `tipo` — sin FK (las entidades
/// referidas no existen todavía en la Fase 14 y el borrado en cascada lo
/// maneja cada módulo dueño al borrar su entidad).
model Notificacion {
  id           String           @id @default(uuid())
  usuarioId    String           @map("usuario_id")
  usuario      Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sedeId       String           @map("sede_id")
  sede         Sede             @relation(fields: [sedeId], references: [id])
  tipo         TipoNotificacion
  referenciaId String           @map("referencia_id")
  titulo       String
  cuerpoCorto  String           @map("cuerpo_corto")
  leidoEn      DateTime?        @map("leido_en")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([usuarioId, leidoEn])
  @@index([usuarioId, createdAt])
  @@index([referenciaId, tipo])
  @@map("notificaciones")
}

/// Evento de calendario escolar — Fase 15, Día 40. `alcanceId` apunta a
/// `Carrera.id` o `Grupo.id` según `alcanceTipo`, o es null si `SEDE` — sin
/// FK (el alcance se valida en `validarAlcancePublicacion`, no vía
/// constraint de DB, mismo criterio que `Notificacion.referenciaId`).
/// `recurrenciaRegla` es `Json?` (shape `ReglaRecurrencia` de
/// `recurrencia.util.ts`, validado en el DTO — no en la DB); las
/// ocurrencias NUNCA se persisten (regla 1), se expanden al vuelo.
/// `fechaFin` es informativo (ver Global Constraints) — no genera
/// ocurrencias adicionales.
model EventoCalendario {
  id               String          @id @default(uuid())
  sedeId           String          @map("sede_id")
  sede             Sede            @relation(fields: [sedeId], references: [id])
  autorUsuarioId   String          @map("autor_usuario_id")
  autor            Usuario         @relation(fields: [autorUsuarioId], references: [id])
  titulo           String
  descripcion      String?
  fechaInicio      DateTime        @map("fecha_inicio") @db.Date
  horaInicio       String?         @map("hora_inicio")
  fechaFin         DateTime?       @map("fecha_fin") @db.Date
  categoria        CategoriaEvento
  alcanceTipo      AlcanceDestino  @map("alcance_tipo")
  alcanceId        String?         @map("alcance_id")
  recurrenciaRegla Json?           @map("recurrencia_regla")
  recurrenciaHasta DateTime?       @map("recurrencia_hasta") @db.Date
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  recordatoriosEnviados RecordatorioEnviado[]

  @@map("eventos_calendario")
}

/// Idempotencia del job de recordatorios — Fase 15, Día 42. Una fila por
/// ocurrencia ya notificada (`@@unique` la hace segura ante corridas
/// solapadas del cron). `onDelete: Cascade` — si se borra el evento, sus
/// recordatorios enviados dejan de tener sentido (no son historial de
/// negocio, regla 5 no aplica).
model RecordatorioEnviado {
  id              String           @id @default(uuid())
  eventoId        String           @map("evento_id")
  evento          EventoCalendario @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  fechaOcurrencia DateTime         @map("fecha_ocurrencia") @db.Date
  enviadoEn       DateTime         @default(now()) @map("enviado_en")

  @@unique([eventoId, fechaOcurrencia])
  @@map("recordatorio_enviado")
}

/// Aviso — Fase 16, Día 45. Broadcast de una vía con recibo de lectura.
/// El recibo NO vive acá: es la fila `Notificacion` (`tipo: AVISO`,
/// `referenciaId: aviso.id`) de cada destinatario, con su `leidoEn`.
/// `alcanceId` apunta a `Carrera.id` o `Grupo.id` según `alcanceTipo`, o
/// es null si `SEDE` — sin FK (el alcance se valida en
/// `validarAlcancePublicacion`, mismo criterio que `EventoCalendario`).
model Aviso {
  id             String         @id @default(uuid())
  sedeId         String         @map("sede_id")
  sede           Sede           @relation(fields: [sedeId], references: [id])
  autorUsuarioId String         @map("autor_usuario_id")
  autor          Usuario        @relation(fields: [autorUsuarioId], references: [id])
  titulo         String
  cuerpo         String
  alcanceTipo    AlcanceDestino @map("alcance_tipo")
  alcanceId      String?        @map("alcance_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([sedeId, createdAt])
  @@map("avisos")
}

model Seccion {
  id     String @id @default(uuid())
  nombre String @unique
  clave  String @unique

  permisos PermisoAdministrativo[]

  @@map("secciones")
}

model PermisoAdministrativo {
  id               String               @id @default(uuid())
  administrativoId String               @map("administrativo_id")
  administrativo   PerfilAdministrativo @relation(fields: [administrativoId], references: [id], onDelete: Cascade)
  seccionId        String               @map("seccion_id")
  seccion          Seccion              @relation(fields: [seccionId], references: [id])
  puedeVer         Boolean              @default(true) @map("puede_ver")
  puedeEditar      Boolean              @default(false) @map("puede_editar")

  @@unique([administrativoId, seccionId])
  @@map("permisos_administrativo")
}
